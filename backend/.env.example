# --- Server ---
PORT=5174
NODE_ENV=development
# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGIN=http://localhost:5173

# --- OpenRouter ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Sent as HTTP-Referer to OpenRouter (used for app analytics).
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Perplexity Clone
# Default model used when the client does not specify one.
DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324:free

# --- Tavily ---
# Get a key at https://app.tavily.com
TAVILY_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
